<?xml version="1.0" encoding="UTF-8"?>
<!-- Read by the metastore and HiveServer2 (apache/hive:3.1.3, through HIVE_CUSTOM_CONF_DIR, replacing the
     image's own hive-site.xml) and by Spark in the client (metastore address). -->
<configuration>
  <property>
    <name>hive.metastore.uris</name>
    <value>thrift://metastore:9083</value>
  </property>
  <property>
    <name>hive.metastore.warehouse.dir</name>
    <value>/user/hive/warehouse</value>
  </property>
  <property>
    <!-- Derby inside the hive_metastore_db volume (mounted where the image lets user hive write). -->
    <name>javax.jdo.option.ConnectionURL</name>
    <value>jdbc:derby:;databaseName=/opt/hive/data/warehouse/metastore_db;create=true</value>
  </property>
  <property>
    <name>metastore.metastore.event.db.notification.api.auth</name>
    <value>false</value>
  </property>
  <property>
    <name>hive.execution.engine</name>
    <value>mr</value>
  </property>
  <property>
    <!-- HiveServer2 runs MapReduce in local mode, so profile core needs no YARN; E5 sets yarn per session. -->
    <name>mapreduce.framework.name</name>
    <value>local</value>
  </property>
  <property>
    <name>hive.exec.submit.local.task.via.child</name>
    <value>false</value>
  </property>
  <property>
    <name>hive.server2.enable.doAs</name>
    <value>false</value>
  </property>
  <property>
    <name>hive.exec.scratchdir</name>
    <value>/tmp/hive</value>
  </property>
  <!-- Hive's jobs on YARN (E1, E5, check hive-yarn): Hive 3.1 needs Java 8 in its tasks (its plan serialisation
       fails on Java 11 with NoSuchFieldException parentOffset); the stack image has it at /opt/java8. -->
  <property>
    <name>yarn.app.mapreduce.am.env</name>
    <value>JAVA_HOME=/opt/java8,HADOOP_MAPRED_HOME=/opt/hadoop</value>
  </property>
  <property>
    <name>mapreduce.map.env</name>
    <value>JAVA_HOME=/opt/java8,HADOOP_MAPRED_HOME=/opt/hadoop</value>
  </property>
  <property>
    <name>mapreduce.reduce.env</name>
    <value>JAVA_HOME=/opt/java8,HADOOP_MAPRED_HOME=/opt/hadoop</value>
  </property>
</configuration>
