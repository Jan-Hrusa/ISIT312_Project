    {
      "text": "%sparksql\nWITH invoice_totals AS (\n    SELECT\n        invoice_id,\n        SUM(amount_gross) AS gross_amount,\n        MAX(payment_status) AS payment_status,\n        MAX(days_late) AS days_late,\n        MAX(issue_date_key) AS issue_date_key,\n        MAX(due_date_key) AS due_date_key\n    FROM fve_dw.fact_invoice_line\n    WHERE project_key \u003d (\n        SELECT project_key\n        FROM fve_dw.dim_project\n        WHERE project_code \u003d \u0027FVE-2026-02\u0027\n    )\n    AND supplier_key \u003d (\n        SELECT supplier_key\n        FROM fve_dw.dim_supplier\n        WHERE ico \u003d \u002768317679\u0027\n           OR name \u003d \u002768317679\u0027\n    )\n    GROUP BY invoice_id\n)\nSELECT\n    i.invoice_id,\n    REGEXP_EXTRACT(i.invoice_id, \u0027^[^-]+-(.*)$\u0027, 1) AS invoice_number,\n    issue_date.full_date AS issue_date,\n    due_date.full_date AS due_date,\n    i.gross_amount,\n    i.payment_status,\n    i.days_late\nFROM invoice_totals i\nLEFT JOIN fve_dw.dim_date issue_date\n    ON i.issue_date_key \u003d issue_date.date_key\nLEFT JOIN fve_dw.dim_date due_date\n    ON i.due_date_key \u003d due_date.date_key\nORDER BY\n    CASE\n        WHEN i.payment_status IN (\u0027OVERDUE\u0027, \u0027UNPAID\u0027) THEN 1\n        WHEN i.payment_status \u003d \u0027PARTLY_PAID\u0027 THEN 2\n        ELSE 3\n    END,\n    due_date ASC,\n    i.invoice_id;",
      "user": "anonymous",
      "dateUpdated": "2026-11-18 14:56:44.625",
      "progress": 0,
      "config": {
        "editorSetting": {
          "language": "sql",
