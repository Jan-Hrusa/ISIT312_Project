    {
      "text": "%sparksql\nWITH invoice_totals AS (\n    SELECT\n        invoice_id,\n        supplier_key,\n        SUM(amount_gross) AS invoiced\n    FROM fve_dw.fact_invoice_line\n    WHERE project_key \u003d (\n        SELECT project_key\n        FROM fve_dw.dim_project\n        WHERE project_code \u003d \u0027FVE-2026-02\u0027\n    )\n    AND category_key \u003d (\n        SELECT category_key\n        FROM fve_dw.dim_cost_category\n        WHERE category_code \u003d \u0027PANELS\u0027\n    )\n    GROUP BY invoice_id, supplier_key\n),\npayments_by_invoice AS (\n    SELECT\n        invoice_id,\n        SUM(amount) AS paid\n    FROM fve_dw.fact_payment\n    GROUP BY invoice_id\n),\nsupplier_totals AS (\n    SELECT\n        i.supplier_key,\n        SUM(i.invoiced) AS invoiced,\n        SUM(COALESCE(p.paid, 0)) AS paid,\n        SUM(i.invoiced - COALESCE(p.paid, 0)) AS open\n    FROM invoice_totals i\n    LEFT JOIN payments_by_invoice p\n        ON i.invoice_id \u003d p.invoice_id\n    GROUP BY i.supplier_key\n)\nSELECT\n    s.name AS supplier,\n    s.ico AS ico,\n    t.invoiced AS invoiced,\n    t.paid AS paid,\n    t.open AS open\nFROM supplier_totals t\nJOIN fve_dw.dim_supplier s\n    ON t.supplier_key \u003d s.supplier_key\nORDER BY t.invoiced DESC, supplier;",
      "user": "anonymous",
      "dateUpdated": "2026-11-18 14:56:44.555",
      "progress": 0,
      "config": {
        "editorSetting": {
          "language": "sql",
          "editOnDblClick": false,
