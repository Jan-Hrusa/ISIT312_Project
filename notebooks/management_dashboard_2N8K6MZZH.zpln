    {
      "text": "%sparksql\nWITH budgets AS (\n    SELECT\n        project_key,\n        SUM(budget_amount) AS budget\n    FROM fve_dw.fact_budget_line\n    GROUP BY project_key\n),\nspending AS (\n    SELECT\n        project_key,\n        SUM(amount_gross) AS spent\n    FROM fve_dw.fact_invoice_line\n    GROUP BY project_key\n)\nSELECT\n    p.project_code AS project,\n    COALESCE(b.budget, 0) AS budget,\n    COALESCE(s.spent, 0) AS spent\nFROM fve_dw.dim_project p\nLEFT JOIN budgets b\n    ON p.project_key \u003d b.project_key\nLEFT JOIN spending s\n    ON p.project_key \u003d s.project_key\nORDER BY spent DESC\nLIMIT 10;",
      "user": "anonymous",
      "dateUpdated": "2026-11-18 15:07:39.049",
      "progress": 0,
