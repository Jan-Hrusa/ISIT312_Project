    },
    {
      "title": "V5 Náklady na MWp, dokončené projekty (Cost per MWp, completed projects)",
      "text": "%sparksql\nSELECT\n    COALESCE(q.project_code, CONCAT(\u0027Rok celkem (year total) \u0027, CAST(q.signed_year AS STRING)))\n        AS `Projekt (project)`,\n    q.signed_year AS `Rok podpisu (signed year)`,\n    q.mwp AS `MWp`,\n    q.total_spent AS `Utraceno (spent)`,\n    q.cost_per_mwp AS `Náklady na MWp (cost per MWp)`\nFROM (\n    WITH project_spend AS (\n        SELECT\n            project_key,\n            SUM(amount_net) AS total_spent\n        FROM fve_dw.fact_invoice_line\n        GROUP BY project_key\n    ),\n\n    completed AS (\n        SELECT\n            p.project_code,\n            p.signed_year,\n            p.mwp,\n            COALESCE(s.total_spent, CAST(0 AS DECIMAL(14,2))) AS total_spent\n        FROM fve_dw.dim_project p\n        LEFT JOIN project_spend s\n            ON p.project_key \u003d s.project_key\n        WHERE p.status \u003d \u0027COMPLETED\u0027\n    )\n\n    SELECT\n        project_code,\n        signed_year,\n        SUM(mwp) AS mwp,\n        SUM(total_spent) AS total_spent,\n        CASE\n            WHEN SUM(mwp) \u003e 0\n            THEN ROUND(SUM(total_spent) / SUM(mwp), 2)\n            ELSE NULL\n        END AS cost_per_mwp\n    FROM completed\n    GROUP BY signed_year, project_code\n    GROUPING SETS ((signed_year, project_code), (signed_year))\n) q\nORDER BY\n    q.signed_year,\n    CASE WHEN q.project_code IS NULL THEN 1 ELSE 0 END,\n    q.project_code",
      "user": "anonymous",
      "dateUpdated": "2026-11-18 14:56:18.664",
      "progress": 0,
      "config": {
