      "id": "paragraph_1795011443467_272490244",
      "dateCreated": "2026-11-18 14:17:23.467",
      "status": "READY"
    },
    {
      "title": "V4 Dodavatel → faktury (Supplier → invoices)",
      "text": "%sparksql\nSELECT\n    v.invoice_number AS `Faktura (invoice)`,\n    v.issue_date AS `Vystaveno (issued)`,\n    v.due_date AS `Splatnost (due)`,\n    v.gross_amount AS `Částka s DPH (gross)`,\n    v.payment_status AS `Stav platby (payment status)`,\n    v.days_late AS `Dní po splatnosti (days late)`\nFROM (\n    WITH invoice_totals AS (\n        SELECT\n            invoice_id,\n            SUM(amount_gross) AS gross_amount,\n            MAX(payment_status) AS payment_status,\n            MAX(days_late) AS days_late,\n            MAX(issue_date_key) AS issue_date_key,\n            MAX(due_date_key) AS due_date_key\n        FROM fve_dw.fact_invoice_line\n        WHERE project_key \u003d (\n            SELECT project_key\n            FROM fve_dw.dim_project\n            WHERE project_code \u003d \u0027$${project\u003dFVE-2026-02}\u0027\n        )\n          AND supplier_key \u003d (\n            SELECT supplier_key\n            FROM fve_dw.dim_supplier\n            WHERE ico \u003d \u0027$${supplier\u003d}\u0027\n               OR name \u003d \u0027$${supplier\u003d}\u0027\n        )\n        GROUP BY invoice_id\n    )\n    SELECT\n        invoice_id,\n        REGEXP_EXTRACT(invoice_id, \u0027^[^-]+-(.*)$\u0027, 1) AS invoice_number,\n        issue_date.full_date AS issue_date,\n        due_date.full_date AS due_date,\n        i.gross_amount AS gross_amount,\n        i.payment_status AS payment_status,\n        i.days_late AS days_late\n    FROM invoice_totals i\n    LEFT JOIN fve_dw.dim_date issue_date\n        ON i.issue_date_key \u003d issue_date.date_key\n    LEFT JOIN fve_dw.dim_date due_date\n        ON i.due_date_key \u003d due_date.date_key\n    ORDER BY\n        CASE\n            WHEN i.payment_status IN (\u0027OVERDUE\u0027, \u0027UNPAID\u0027) THEN 1\n            WHEN i.payment_status \u003d \u0027PARTLY_PAID\u0027 THEN 2\n            ELSE 3\n        END,\n        due_date ASC,\n        invoice_id\n) v\nORDER BY\n    CASE\n        WHEN v.payment_status IN (\u0027OVERDUE\u0027, \u0027UNPAID\u0027) THEN 1\n        WHEN v.payment_status \u003d \u0027PARTLY_PAID\u0027 THEN 2\n        ELSE 3\n    END,\n    v.due_date,\n    v.invoice_id",
      "user": "anonymous",
      "dateUpdated": "2026-11-18 14:56:44.625",
      "progress": 0,
      "config": {
        "editorSetting": {
          "language": "sql",
          "editOnDblClick": false
        },
        "colWidth": 12.0,
        "editorMode": "ace/mode/sql",
        "editorHide": true,
