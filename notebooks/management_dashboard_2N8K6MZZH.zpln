    {
      "text": "%sparksql\nSELECT\n    c.group_name AS group_name,\n    d.year AS year,\n    SUM(i.amount_net) AS spent\nFROM fve_dw.fact_invoice_line i\nJOIN fve_dw.dim_cost_category c\n    ON i.category_key \u003d c.category_key\nJOIN fve_dw.dim_date d\n    ON i.issue_date_key \u003d d.date_key\nGROUP BY c.group_name, d.year WITH CUBE\nORDER BY year, group_name;",
      "user": "anonymous",
      "dateUpdated": "2026-11-18 14:56:30.657",
