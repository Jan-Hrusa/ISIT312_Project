    {
      "title": "Obnovit tabulky (Refresh tables after a pipeline run)",
      "text": "%sparksql\nREFRESH TABLE fve_dw.dim_project;\nREFRESH TABLE fve_dw.dim_supplier;\nREFRESH TABLE fve_dw.dim_cost_category;\nREFRESH TABLE fve_dw.dim_date;\nREFRESH TABLE fve_dw.fact_budget_line;\nREFRESH TABLE fve_dw.fact_invoice_line;\nREFRESH TABLE fve_dw.fact_payment;",
