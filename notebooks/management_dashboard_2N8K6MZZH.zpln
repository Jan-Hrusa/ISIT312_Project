      "jobName": "paragraph_1795011250195_476579759",
      "id": "paragraph_1795011250195_476579759",
      "dateCreated": "2026-11-18 14:14:10.195",
      "status": "READY"
    },
    {
      "title": "V3 Kategorie → dodavatelé (Category → suppliers)",
      "text": "%sparksql\nSELECT\n    v.supplier AS `Dodavatel (supplier)`,\n    v.ico AS `IČO (company ID)`,\n    v.invoiced AS `Fakturováno s DPH (invoiced, gross)`,\n    v.paid AS `Zaplaceno (paid)`,\n    v.open AS `Neuhrazeno (open)`\nFROM (\n    WITH invoice_totals AS (\n        SELECT\n            invoice_id,\n            supplier_key,\n            SUM(amount_gross) AS invoiced\n        FROM fve_dw.fact_invoice_line\n        WHERE project_key \u003d (\n            SELECT project_key\n            FROM fve_dw.dim_project\n            WHERE project_code \u003d \u0027$${project\u003dFVE-2026-02}\u0027\n        )\n          AND category_key \u003d (\n            SELECT category_key\n            FROM fve_dw.dim_cost_category\n            WHERE category_code \u003d \u0027$${category\u003dPANELS}\u0027\n        )\n        GROUP BY invoice_id, supplier_key\n    ),\n    payments_by_invoice AS (\n        SELECT invoice_id, SUM(amount) AS paid\n        FROM fve_dw.fact_payment\n        GROUP BY invoice_id\n    ),\n    supplier_totals AS (\n        SELECT\n            i.supplier_key,\n            SUM(i.invoiced) AS invoiced,\n            SUM(COALESCE(p.paid, 0)) AS paid,\n            SUM(i.invoiced - COALESCE(p.paid, 0)) AS open\n        FROM invoice_totals i\n        LEFT JOIN payments_by_invoice p\n            ON i.invoice_id \u003d p.invoice_id\n        GROUP BY i.supplier_key\n    )\n    SELECT\n        s.name AS supplier,\n        s.ico AS ico,\n        t.invoiced AS invoiced,\n        t.paid AS paid,\n        t.open AS open\n    FROM supplier_totals t\n    JOIN fve_dw.dim_supplier s\n        ON t.supplier_key \u003d s.supplier_key\n    ORDER BY t.invoiced DESC, supplier\n) v\nORDER BY v.invoiced DESC, v.supplier",
      "user": "anonymous",
      "dateUpdated": "2026-11-18 14:56:44.555",
      "progress": 0,
      "config": {
        "editorSetting": {
          "language": "sql",
          "editOnDblClick": false
        },
        "colWidth": 12.0,
        "editorMode": "ace/mode/sql",
        "editorHide": true,
        "fontSize": 9.0,
