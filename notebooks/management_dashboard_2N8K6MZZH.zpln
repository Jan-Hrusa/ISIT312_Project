    {
      "title": "V5 Výdaje podle skupiny nákladů a roku (Spend by cost group and year, with totals)",
      "text": "%sparksql\nSELECT\n    COALESCE(q.group_name, \u0027Celkem (total)\u0027) AS `Skupina nákladů (cost group)`,\n    COALESCE(CAST(q.year AS STRING), \u0027Celkem (total)\u0027) AS `Rok (year)`,\n    q.spent AS `Utraceno (spent)`\nFROM (\n    SELECT\n        c.group_name AS group_name,\n        d.year AS year,\n        SUM(i.amount_net) AS spent\n    FROM fve_dw.fact_invoice_line i\n    JOIN fve_dw.dim_cost_category c\n        ON i.category_key \u003d c.category_key\n    JOIN fve_dw.dim_date d\n        ON i.issue_date_key \u003d d.date_key\n    GROUP BY c.group_name, d.year WITH CUBE\n) q\nORDER BY\n    CASE WHEN q.year IS NULL THEN 1 ELSE 0 END,\n    q.year,\n    CASE WHEN q.group_name IS NULL THEN 1 ELSE 0 END,\n    q.group_name",
      "user": "anonymous",
      "dateUpdated": "2026-11-18 14:56:30.657",
      "progress": 0,
      "config": {
        "editorSetting": {
          "language": "sql",
