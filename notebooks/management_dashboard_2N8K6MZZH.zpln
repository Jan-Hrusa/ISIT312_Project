      "status": "FINISHED"
    },
    {
      "text": "%sparksql\nWITH budget_by_category AS (\n    SELECT\n        project_key,\n        category_key,\n        SUM(budget_amount) AS budget\n    FROM fve_dw.fact_budget_line\n    GROUP BY project_key, category_key\n),\nspent_by_category AS (\n    SELECT\n        project_key,\n        category_key,\n        SUM(amount_net) AS spent\n    FROM fve_dw.fact_invoice_line\n    GROUP BY project_key, category_key\n),\ncategory_results AS (\n    SELECT\n        b.category_key,\n        b.project_key,\n        b.budget,\n        COALESCE(s.spent, CAST(0 AS DECIMAL(14,2))) AS spent\n    FROM budget_by_category b\n    LEFT JOIN spent_by_category s\n        ON b.project_key \u003d s.project_key\n        AND b.category_key \u003d s.category_key\n),\noverruns AS (\n    SELECT\n        category_key,\n        CASE WHEN spent \u003e budget THEN 1 ELSE 0 END AS over_budget,\n        CASE\n            WHEN budget \u003e 0 AND spent \u003e budget\n            THEN (spent - budget) * 100.0 / budget\n            ELSE NULL\n        END AS overrun_pct\n    FROM category_results r\n    JOIN fve_dw.dim_project p\n        ON r.project_key \u003d p.project_key\n    WHERE p.status \u003d \u0027COMPLETED\u0027\n),\ncategory_summary AS (\n    SELECT\n        category_key,\n        SUM(over_budget) AS projects_over,\n        COALESCE(AVG(overrun_pct), 0) AS avg_overrun_pct\n    FROM overruns\n    GROUP BY category_key\n)\nSELECT\n    c.category_code AS category_code,\n    s.projects_over AS projects_over,\n    ROUND(s.avg_overrun_pct, 2) AS avg_overrun_pct,\n    RANK() OVER (\n        ORDER BY s.projects_over DESC, s.avg_overrun_pct DESC\n    ) AS category_rank\nFROM category_summary s\nJOIN fve_dw.dim_cost_category c\n    ON s.category_key \u003d c.category_key\nORDER BY category_rank;",
      "user": "anonymous",
      "dateUpdated": "2026-11-18 14:56:44.841",
      "progress": 0,
