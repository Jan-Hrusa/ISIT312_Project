    },
    {
      "title": "Křivka čerpání projektu (Spending curve of the project)",
      "text": "%sparksql\nSELECT\n    CONCAT(CAST(q.year AS STRING), \u0027-\u0027, LPAD(CAST(q.month AS STRING), 2, \u00270\u0027)) AS `Měsíc (month)`,\n    q.spent AS `Utraceno v měsíci (spent in the month)`,\n    q.cumulative_spend AS `Utraceno celkem (cumulative spend)`\nFROM (\n    WITH monthly_spend AS (\n        SELECT\n            i.project_key,\n            d.year,\n            d.month,\n            SUM(i.amount_net) AS spent\n        FROM fve_dw.fact_invoice_line i\n        JOIN fve_dw.dim_date d\n            ON i.issue_date_key \u003d d.date_key\n        GROUP BY\n            i.project_key,\n            d.year,\n            d.month\n    )\n\n    SELECT\n        p.project_code AS project_code,\n        m.year AS year,\n        m.month AS month,\n        m.spent AS spent,\n        SUM(m.spent) OVER (\n            PARTITION BY m.project_key\n            ORDER BY m.year * 100 + m.month\n            ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW\n        ) AS cumulative_spend\n    FROM monthly_spend m\n    JOIN fve_dw.dim_project p\n        ON m.project_key \u003d p.project_key\n) q\nWHERE q.project_code \u003d \u0027$${project\u003dFVE-2026-02}\u0027\nORDER BY q.year * 100 + q.month",
      "user": "anonymous",
      "dateUpdated": "2026-11-18 14:56:15.831",
      "progress": 0,
      "config": {
        "editorSetting": {
          "language": "sql",
          "editOnDblClick": false
