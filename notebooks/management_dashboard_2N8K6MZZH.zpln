    {
      "text": "%sparksql\nWITH budgets AS (\n    SELECT\n        project_key,\n        SUM(budget_amount) AS total_budget\n    FROM fve_dw.fact_budget_line\n    GROUP BY project_key\n),\nspending AS (\n    SELECT\n        project_key,\n        SUM(amount_gross) AS total_spent\n    FROM fve_dw.fact_invoice_line\n    GROUP BY project_key\n)\nSELECT\n    p.project_code AS `Projekt`,\n    p.name AS `Název projektu`,\n    p.status AS `Stav`,\n    COALESCE(b.total_budget, 0) AS `Rozpočet`,\n    COALESCE(s.total_spent, 0) AS `Skutečné náklady`,\n    CASE\n        WHEN b.total_budget IS NULL OR b.total_budget \u003d 0\n            THEN \u0027⚪ Bez rozpočtu\u0027\n        WHEN COALESCE(s.total_spent, 0) \u003e b.total_budget\n            THEN \u0027🔴 Překročen rozpočet\u0027\n        WHEN COALESCE(s.total_spent, 0) \u003e\u003d b.total_budget * 0.9\n            THEN \u0027🟡 Blízko rozpočtu\u0027\n        ELSE \u0027🟢 V pořádku\u0027\n    END AS `Rozpočtový stav`\nFROM fve_dw.dim_project p\nLEFT JOIN budgets b\n    ON p.project_key \u003d b.project_key\nLEFT JOIN spending s\n    ON p.project_key \u003d s.project_key\nORDER BY `Skutečné náklady` DESC;",
      "user": "anonymous",
      "dateUpdated": "2026-11-18 15:03:16.768",
      "progress": 0,
      "config": {
