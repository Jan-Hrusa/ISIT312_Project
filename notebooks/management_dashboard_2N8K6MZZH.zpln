      "jobName": "paragraph_1795011156142_985571766",
      "id": "paragraph_1795011156142_985571766",
      "dateCreated": "2026-11-18 14:12:36.142",
      "status": "READY"
    },
    {
      "title": "V2 Detail projektu podle kategorií (Project detail by cost category)",
      "text": "%sparksql\nSELECT\n    COALESCE(q.category_code, \u0027Celkem (total)\u0027) AS `Kategorie (category)`,\n    q.budget AS `Rozpočet (budget)`,\n    q.spent AS `Utraceno (spent)`,\n    q.difference AS `Rozdíl (difference)`,\n    q.pct_spent AS `Čerpání % (% of budget spent)`,\n    CASE\n        WHEN q.category_code IS NULL THEN\n            -- the total row carries the project\u0027s light of V1 (Task 11): a red or amber category counts too\n            CASE\n                WHEN q.spent \u003e q.budget * 1.10 OR MAX(\n                    CASE WHEN q.category_code IS NOT NULL AND ((q.budget \u003d 0 AND q.spent \u003e 0)\n                        OR q.spent \u003e q.budget * 1.15) THEN 1 ELSE 0 END\n                ) OVER () \u003d 1 THEN \u0027🔴 červená (red)\u0027\n                WHEN q.spent \u003e q.budget OR MAX(\n                    CASE WHEN q.category_code IS NOT NULL AND q.spent \u003e q.budget * 1.05 THEN 1 ELSE 0 END\n                ) OVER () \u003d 1 THEN \u0027🟡 oranžová (amber)\u0027\n                ELSE \u0027🟢 zelená (green)\u0027\n            END\n        WHEN q.budget \u003d 0 AND q.spent \u003e 0 THEN \u0027🔴 červená (red)\u0027\n        WHEN q.spent \u003e q.budget * 1.15 THEN \u0027🔴 červená (red)\u0027\n        WHEN q.spent \u003e q.budget * 1.05 THEN \u0027🟡 oranžová (amber)\u0027\n        ELSE \u0027🟢 zelená (green)\u0027\n    END AS `Semafor (traffic light)`\nFROM (\n    WITH budget_by_category AS (\n        SELECT\n            project_key,\n            category_key,\n            SUM(budget_amount) AS budget\n        FROM fve_dw.fact_budget_line\n        GROUP BY project_key, category_key\n    ),\n\n    spent_by_category AS (\n        SELECT\n            project_key,\n            category_key,\n            SUM(amount_net) AS spent\n        FROM fve_dw.fact_invoice_line\n        GROUP BY project_key, category_key\n    ),\n\n    combined AS (\n        SELECT\n            project_key,\n            category_key,\n            budget,\n            CAST(0 AS DECIMAL(14,2)) AS spent\n        FROM budget_by_category\n\n        UNION ALL\n\n        SELECT\n            project_key,\n            category_key,\n            CAST(0 AS DECIMAL(14,2)) AS budget,\n            spent\n        FROM spent_by_category\n    ),\n\n    totals AS (\n        SELECT\n            project_key,\n            category_key,\n            SUM(budget) AS budget,\n            SUM(spent) AS spent\n        FROM combined\n        GROUP BY project_key, category_key\n    )\n\n    SELECT\n        p.project_code AS project_code,\n        c.category_code AS category_code,\n        SUM(t.budget) AS budget,\n        SUM(t.spent) AS spent,\n        SUM(t.budget) - SUM(t.spent) AS difference,\n        CASE\n            WHEN SUM(t.budget) \u003d 0 THEN NULL\n            ELSE ROUND(\n                SUM(t.spent) * 100.0 / SUM(t.budget),\n                2\n            )\n        END AS pct_spent\n    FROM totals t\n    JOIN fve_dw.dim_project p\n        ON t.project_key \u003d p.project_key\n    JOIN fve_dw.dim_cost_category c\n        ON t.category_key \u003d c.category_key\n    GROUP BY p.project_code, c.category_code WITH ROLLUP\n) q\nWHERE q.project_code \u003d \u0027$${project\u003dFVE-2026-02}\u0027\nORDER BY\n    CASE WHEN q.category_code IS NULL THEN 1 ELSE 0 END,\n    CASE WHEN q.budget \u003d 0 AND q.spent \u003e 0 THEN 0 ELSE 1 END,\n    q.pct_spent DESC",
      "user": "anonymous",
      "dateUpdated": "2026-11-18 14:55:55.977",
      "progress": 0,
      "config": {
        "editorSetting": {
          "language": "sql",
          "editOnDblClick": false
        },
        "colWidth": 12.0,
        "editorMode": "ace/mode/sql",
        "editorHide": true,
        "fontSize": 9.0,
        "title": true,
        "results": {
