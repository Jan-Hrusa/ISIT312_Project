    {
      "text": "%sparksql\nWITH monthly_spend AS (\n    SELECT\n        i.project_key,\n        d.year,\n        d.month,\n        SUM(i.amount_net) AS spent\n    FROM fve_dw.fact_invoice_line i\n    JOIN fve_dw.dim_date d\n        ON i.issue_date_key \u003d d.date_key\n    GROUP BY\n        i.project_key,\n        d.year,\n        d.month\n)\nSELECT\n    m.year AS year,\n    m.month AS month,\n    m.spent AS spent,\n    SUM(m.spent) OVER (\n        PARTITION BY m.project_key\n        ORDER BY m.year * 100 + m.month\n        ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW\n    ) AS cumulative_spend\nFROM monthly_spend m\nJOIN fve_dw.dim_project p\n    ON m.project_key \u003d p.project_key\nWHERE p.project_code \u003d \u0027FVE-2026-02\u0027\nORDER BY m.year, m.month;",
      "user": "anonymous",
      "dateUpdated": "2026-11-18 14:56:15.831",
      "progress": 0,
      "config": {
        "editorSetting": {
          "language": "sql",
