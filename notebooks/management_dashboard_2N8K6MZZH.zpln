      "jobName": "paragraph_1795012519678_886367104",
      "id": "paragraph_1795012519678_886367104",
      "dateCreated": "2026-11-18 14:35:19.679",
      "status": "READY"
    },
    {
      "title": "V1 Projekty: rozpočet, utraceno a semafor (Projects: budget, spent and traffic light)",
      "text": "%sparksql\nSELECT\n    CASE v.traffic_light\n        WHEN \u0027RED\u0027 THEN \u0027🔴 červená (red)\u0027\n        WHEN \u0027AMBER\u0027 THEN \u0027🟡 oranžová (amber)\u0027\n        ELSE \u0027🟢 zelená (green)\u0027\n    END AS `Semafor (traffic light)`,\n    v.project_code AS `Projekt (project)`,\n    v.name AS `Název (name)`,\n    v.region AS `Kraj (region)`,\n    v.mwp AS `MWp`,\n    v.status AS `Stav (status)`,\n    v.contract_value AS `Hodnota smlouvy (contract value)`,\n    v.budget AS `Rozpočet (budget)`,\n    v.spent AS `Utraceno (spent)`,\n    v.pct_spent AS `Čerpání % (% of budget spent)`,\n    v.expected_margin AS `Očekávaná marže (expected margin)`\nFROM (\n    WITH budget_by_category AS (\n        SELECT\n            project_key,\n            category_key,\n            SUM(budget_amount) AS budget\n        FROM fve_dw.fact_budget_line\n        GROUP BY project_key, category_key\n    ),\n\n    spent_by_category AS (\n        SELECT\n            project_key,\n            category_key,\n            SUM(amount_net) AS spent\n        FROM fve_dw.fact_invoice_line\n        GROUP BY project_key, category_key\n    ),\n\n    combined AS (\n        SELECT\n            project_key,\n            category_key,\n            budget,\n            CAST(0 AS DECIMAL(14,2)) AS spent\n        FROM budget_by_category\n\n        UNION ALL\n\n        SELECT\n            project_key,\n            category_key,\n            CAST(0 AS DECIMAL(14,2)) AS budget,\n            spent\n        FROM spent_by_category\n    ),\n\n    category_totals AS (\n        SELECT\n            project_key,\n            category_key,\n            SUM(budget) AS budget,\n            SUM(spent) AS spent\n        FROM combined\n        GROUP BY project_key, category_key\n    ),\n\n    category_flags AS (\n        SELECT\n            project_key,\n            MAX(\n                CASE\n                    WHEN budget \u003d 0 AND spent \u003e 0 THEN 1\n                    WHEN budget \u003e 0 AND spent \u003e budget * 1.15 THEN 1\n                    ELSE 0\n                END\n            ) AS category_red,\n            MAX(\n                CASE\n                    WHEN budget \u003e 0 AND spent \u003e budget * 1.05 THEN 1\n                    ELSE 0\n                END\n            ) AS category_amber\n        FROM category_totals\n        GROUP BY project_key\n    ),\n\n    project_totals AS (\n        SELECT\n            project_key,\n            SUM(budget) AS budget,\n            SUM(spent) AS spent\n        FROM category_totals\n        GROUP BY project_key\n    ),\n\n    dashboard AS (\n        SELECT\n            p.project_code,\n            p.name,\n            p.region,\n            p.mwp,\n            p.status,\n            p.contract_value,\n            COALESCE(t.budget, CAST(0 AS DECIMAL(14,2))) AS budget,\n            COALESCE(t.spent, CAST(0 AS DECIMAL(14,2))) AS spent,\n            CASE\n                WHEN COALESCE(t.budget, 0) \u003d 0 THEN NULL\n                ELSE ROUND(t.spent * 100.0 / t.budget, 2)\n            END AS pct_spent,\n            p.contract_value -\n                CASE\n                    WHEN COALESCE(t.budget, 0) \u003e COALESCE(t.spent, 0)\n                        THEN COALESCE(t.budget, 0)\n                    ELSE COALESCE(t.spent, 0)\n                END AS expected_margin,\n            CASE\n                WHEN COALESCE(f.category_red, 0) \u003d 1\n                    OR COALESCE(t.spent, 0) \u003e COALESCE(t.budget, 0) * 1.10\n                    THEN \u0027RED\u0027\n                WHEN COALESCE(f.category_amber, 0) \u003d 1\n                    OR COALESCE(t.spent, 0) \u003e COALESCE(t.budget, 0)\n                    THEN \u0027AMBER\u0027\n                ELSE \u0027GREEN\u0027\n            END AS traffic_light\n        FROM fve_dw.dim_project p\n        LEFT JOIN project_totals t\n            ON p.project_key \u003d t.project_key\n        LEFT JOIN category_flags f\n            ON p.project_key \u003d f.project_key\n        WHERE p.status IN (\u0027ACTIVE\u0027, \u0027COMPLETED\u0027)\n    )\n\n    SELECT\n        project_code,\n        name,\n        region,\n        mwp,\n        status,\n        contract_value,\n        budget,\n        spent,\n        pct_spent,\n        expected_margin,\n        traffic_light\n    FROM dashboard\n    ORDER BY\n        CASE traffic_light\n            WHEN \u0027RED\u0027 THEN 1\n            WHEN \u0027AMBER\u0027 THEN 2\n            ELSE 3\n        END,\n        CASE WHEN pct_spent IS NULL THEN 0 ELSE 1 END,\n        pct_spent DESC\n) v\nORDER BY\n    CASE v.traffic_light WHEN \u0027RED\u0027 THEN 1 WHEN \u0027AMBER\u0027 THEN 2 ELSE 3 END,\n    CASE WHEN v.pct_spent IS NULL THEN 0 ELSE 1 END,\n    v.pct_spent DESC",
      "user": "anonymous",
      "dateUpdated": "2026-11-18 15:03:16.768",
      "progress": 0,
      "config": {
        "editorSetting": {
          "language": "sql",
          "editOnDblClick": false
        },
        "colWidth": 12.0,
        "editorMode": "ace/mode/sql",
        "editorHide": true,
