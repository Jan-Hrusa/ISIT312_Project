    {
      "text": "%sparksql\nWITH project_spend AS (\n    SELECT\n        project_key,\n        SUM(amount_net) AS total_spent\n    FROM fve_dw.fact_invoice_line\n    GROUP BY project_key\n),\ncompleted AS (\n    SELECT\n        p.project_code,\n        p.signed_year,\n        p.mwp,\n        COALESCE(s.total_spent, CAST(0 AS DECIMAL(14,2))) AS total_spent\n    FROM fve_dw.dim_project p\n    LEFT JOIN project_spend s\n        ON p.project_key \u003d s.project_key\n    WHERE p.status \u003d \u0027COMPLETED\u0027\n)\nSELECT\n    project_code,\n    signed_year,\n    SUM(mwp) AS mwp,\n    SUM(total_spent) AS total_spent,\n    CASE\n        WHEN SUM(mwp) \u003e 0\n        THEN ROUND(SUM(total_spent) / SUM(mwp), 2)\n        ELSE NULL\n    END AS cost_per_mwp\nFROM completed\nGROUP BY signed_year, project_code\nGROUPING SETS ((signed_year, project_code), (signed_year))\nORDER BY signed_year, project_code;",
      "user": "anonymous",
      "dateUpdated": "2026-11-18 14:56:18.664",
      "progress": 0,
