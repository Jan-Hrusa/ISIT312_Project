    {
      "text": "%sparksql\nWITH budget_by_category AS (\n    SELECT\n        project_key,\n        category_key,\n        SUM(budget_amount) AS budget\n    FROM fve_dw.fact_budget_line\n    GROUP BY project_key, category_key\n),\nspent_by_category AS (\n    SELECT\n        project_key,\n        category_key,\n        SUM(amount_net) AS spent\n    FROM fve_dw.fact_invoice_line\n    GROUP BY project_key, category_key\n),\ncombined AS (\n    SELECT project_key, category_key, budget,\n           CAST(0 AS DECIMAL(14,2)) AS spent\n    FROM budget_by_category\n\n    UNION ALL\n\n    SELECT project_key, category_key,\n           CAST(0 AS DECIMAL(14,2)) AS budget, spent\n    FROM spent_by_category\n),\ntotals AS (\n    SELECT\n        project_key,\n        category_key,\n        SUM(budget) AS budget,\n        SUM(spent) AS spent\n    FROM combined\n    GROUP BY project_key, category_key\n)\nSELECT\n    c.category_code AS `Kategorie`,\n    SUM(t.budget) AS `Rozpočet`,\n    SUM(t.spent) AS `Skutečné náklady`,\n    SUM(t.budget) - SUM(t.spent) AS `Zbývá`,\n    CASE\n        WHEN SUM(t.budget) \u003d 0 THEN NULL\n        ELSE ROUND(SUM(t.spent) * 100.0 / SUM(t.budget), 2)\n    END AS `Čerpání (%)`,\n    CASE\n        WHEN SUM(t.budget) \u003d 0 THEN \u0027⚪ Bez rozpočtu\u0027\n        WHEN SUM(t.spent) \u003e SUM(t.budget) THEN \u0027🔴 Překročen\u0027\n        WHEN SUM(t.spent) \u003e\u003d SUM(t.budget) * 0.9 THEN \u0027🟡 Blízko limitu\u0027\n        ELSE \u0027🟢 V pořádku\u0027\n    END AS `Stav`\nFROM totals t\nJOIN fve_dw.dim_project p\n    ON t.project_key \u003d p.project_key\nJOIN fve_dw.dim_cost_category c\n    ON t.category_key \u003d c.category_key\nWHERE p.project_code \u003d \u0027FVE-2026-02\u0027\nGROUP BY c.category_code\nORDER BY\n    CASE\n        WHEN SUM(t.spent) \u003e SUM(t.budget) THEN 0\n        WHEN SUM(t.budget) \u003e 0\n             AND SUM(t.spent) \u003e\u003d SUM(t.budget) * 0.9 THEN 1\n        ELSE 2\n    END,\n    SUM(t.spent) - SUM(t.budget) DESC;",
      "user": "anonymous",
      "dateUpdated": "2026-11-18 14:55:55.977",
      "progress": 0,
