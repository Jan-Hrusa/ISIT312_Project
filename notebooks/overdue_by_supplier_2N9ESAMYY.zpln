    {
      "title": "Faktury po splatnosti podle dodavatele (Overdue invoices by supplier, largest open amount first)",
      "text": "%sparksql\nSELECT\n    s.name AS supplier,\n    s.ico AS ico,\n    COUNT(*) AS overdue_invoices,\n    SUM(v.total_gross - st.paid_amount) AS open_amount,\n    MIN(v.due_date) AS oldest_due_date,\n    ROUND(AVG(st.days_late), 1) AS avg_days_late\nFROM fve_clean.invoice_status st\nJOIN fve_clean.invoices v\n    ON v.invoice_id \u003d st.invoice_id\nLEFT JOIN fve_clean.suppliers s\n    ON s.ico \u003d v.supplier_ico\nWHERE st.status \u003d \u0027OVERDUE\u0027\nGROUP BY s.name, s.ico\nORDER BY open_amount DESC, supplier",
      "user": "anonymous",
      "dateUpdated": "2026-11-17 10:46:23.756",
      "progress": 0,
      "config": {
        "editorSetting": {
          "language": "sql"
        },
        "colWidth": 12.0,
        "editorHide": false,
        "fontSize": 9.0,
        "title": true,
