    {
      "title": "Faktury jednoho dodavatele – zadejte název nebo IČO (One supplier\u0027s invoices – enter name or IČO)",
      "text": "%sparksql\nSELECT\n    v.invoice_id,\n    v.number,\n    v.issue_date,\n    v.due_date,\n    v.total_gross,\n    st.status,\n    st.paid_amount,\n    v.total_gross - st.paid_amount AS open_amount,\n    st.paid_date,\n    st.days_late,\n    v.project_code\nFROM fve_clean.invoices v\nJOIN fve_clean.suppliers s\n    ON s.ico \u003d v.supplier_ico\nLEFT JOIN fve_clean.invoice_status st\n    ON st.invoice_id \u003d v.invoice_id\nWHERE s.name \u003d \u0027${supplier\u003d}\u0027 OR s.ico \u003d \u0027${supplier\u003d}\u0027\nORDER BY due_date DESC, invoice_id",
      "user": "anonymous",
      "dateUpdated": "2026-11-17 10:46:23.839",
