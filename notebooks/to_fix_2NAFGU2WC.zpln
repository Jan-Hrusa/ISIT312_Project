    {
      "title": "Fotky mimo všechny stavby (Photos taken outside every site)",
      "text": "%sparksql\nSELECT\n    m.original_name AS original_name,\n    m.taken_at AS taken_at,\n    m.lat AS lat,\n    m.lon AS lon,\n    m.device AS device,\n    i.project_code AS nearest_project,\n    i.detail AS detail\nFROM fve_clean.dq_issues i\nLEFT JOIN fve_clean.media_files m\n    ON m.file_id \u003d i.record_ref\nWHERE i.issue_type \u003d \u0027UNASSIGNED_PHOTO\u0027\nORDER BY taken_at, original_name",
      "user": "anonymous",
      "dateUpdated": "2026-11-17 10:50:48.114",
      "progress": 0,
