    {
      "title": "Počet problémů podle typu a úlohy (Issues per type and job)",
      "text": "%sparksql\nSELECT\n    issue_type,\n    job,\n    COUNT(*) AS issues\nFROM fve_clean.dq_issues\nGROUP BY issue_type, job\nORDER BY issues DESC, issue_type, job",
