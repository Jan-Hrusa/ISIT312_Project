    {
      "title": "Nespárované platby a navržená faktura (Unmatched payments with the suggested invoice)",
      "text": "%sparksql\nSELECT\n    t.value_date,\n    t.bank,\n    i.record_ref AS tx_id,\n    -t.amount AS amount,\n    t.counterparty_account,\n    t.counterparty_bank_code,\n    t.vs,\n    NULLIF(regexp_extract(i.detail, \u0027suggested match: ([^ ]+)\u0027, 1), \u0027\u0027) AS suggested_invoice,\n    i.project_code,\n    i.detail\nFROM fve_clean.dq_issues i\nLEFT JOIN fve_clean.bank_transactions t\n    ON t.tx_id \u003d i.record_ref\nWHERE i.issue_type \u003d \u0027UNMATCHED_PAYMENT\u0027\nORDER BY value_date, tx_id",
