    {
      "title": "Faktury a náklady bez projektu (Invoices and booked costs without a project)",
      "text": "%sparksql\nSELECT\n    i.source AS source,\n    i.record_ref AS record_ref,\n    s.name AS supplier,\n    COALESCE(v.issue_date, b.issue_date) AS issue_date,\n    COALESCE(v.total_gross, b.amount_gross) AS amount_gross,\n    i.detail AS detail\nFROM fve_clean.dq_issues i\nLEFT JOIN fve_clean.invoices v\n    ON i.source \u003d \u0027isdoc\u0027 AND v.invoice_id \u003d i.record_ref\nLEFT JOIN (\n    SELECT\n        doc_ref,\n        MIN(supplier_ico) AS supplier_ico,\n        MIN(issue_date) AS issue_date,\n        SUM(amount_gross) AS amount_gross\n    FROM fve_clean.booked_costs\n    GROUP BY doc_ref\n) b\n    ON i.source \u003d \u0027accounting\u0027 AND b.doc_ref \u003d i.record_ref\nLEFT JOIN fve_clean.suppliers s\n    ON s.ico \u003d COALESCE(v.supplier_ico, b.supplier_ico)\nWHERE i.issue_type \u003d \u0027NO_PROJECT\u0027\nORDER BY source, issue_date, record_ref",
      "user": "anonymous",
      "dateUpdated": "2026-11-17 10:39:58.265",
      "progress": 0,
      "config": {
        "editorSetting": {
          "language": "sql"
        },
        "colWidth": 12.0,
        "editorHide": false,
        "fontSize": 9.0,
        "title": true,
        "results": {
