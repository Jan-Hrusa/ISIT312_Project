    {
      "title": "Duplicitní faktury (Duplicate invoices)",
      "text": "%sparksql\nSELECT\n    i.record_ref AS invoice_id,\n    s.name AS supplier,\n    v.number,\n    v.total_gross,\n    v.source_file AS kept_file,\n    i.detail AS dropped_file,\n    i.project_code\nFROM fve_clean.dq_issues i\nLEFT JOIN fve_clean.invoices v\n    ON v.invoice_id \u003d i.record_ref\nLEFT JOIN fve_clean.suppliers s\n    ON s.ico \u003d v.supplier_ico\nWHERE i.issue_type \u003d \u0027DUPLICATE\u0027\nORDER BY supplier, invoice_id",
