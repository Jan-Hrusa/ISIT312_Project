    {
      "title": "Platební příkazy bez odepsání z účtu (Payment orders never cleared)",
      "text": "%sparksql\nSELECT\n    o.order_date AS order_date,\n    o.due_date AS due_date,\n    o.bank AS bank,\n    i.record_ref AS order_id,\n    o.amount AS amount,\n    o.counterparty_account AS counterparty_account,\n    o.counterparty_bank_code AS counterparty_bank_code,\n    o.vs AS vs,\n    NULLIF(regexp_extract(i.detail, \u0027for invoice ([^ ]+)\u0027, 1), \u0027\u0027) AS invoice_id,\n    i.project_code AS project_code\nFROM fve_clean.dq_issues i\nLEFT JOIN fve_clean.payment_orders o\n    ON o.order_id \u003d i.record_ref\nWHERE i.issue_type \u003d \u0027ORDER_NOT_CLEARED\u0027\nORDER BY due_date, order_id",
      "user": "anonymous",
      "dateUpdated": "2026-11-17 10:39:58.328",
      "progress": 0,
      "config": {
