    {
      "title": "Nezařazené (Unassigned photos and files)",
      "text": "%python\n# Nezařazené fotky a soubory: prefix UNASSIGNED# (items filed to no project: one prefix scan per kind)\nimport pandas as pd\n\nfrom hbase import catalogue, search\n\ncounts \u003d {kind: len(search.unassigned(kind, limit\u003dNone)) for kind in catalogue.KINDS}\nprint(\"Počty podle druhu (counts by kind): \" + \", \".join(f\"{k} {n}\" for k, n in counts.items()))\nnewest \u003d search.unassigned(limit\u003d20)\nz.show(pd.DataFrame(\n    [{\"kind\": r[\"kind\"], \"taken_at\": (r[\"taken_at\"].strftime(\"%Y-%m-%d %H:%M:%S\") if r[\"taken_at\"] else None), \"name\": r[\"original_name\"], \"lat\": r[\"lat\"], \"lon\": r[\"lon\"],\n      \"device\": r[\"device\"]} for r in newest],\n    columns\u003d[\"kind\", \"taken_at\", \"name\", \"lat\", \"lon\", \"device\"],\n))\n",
      "user": "anonymous",
