{
  "paragraphs": [
    {
      "title": "Fotky stavby za období (Photos of a project between two dates)",
      "text": "%python\n# Fotky stavby za období: jeden rozsah klíčů v HBase (photos of a project between two dates: one HBase range scan)\nimport base64\nfrom datetime import date\n\nimport pandas as pd\n\nfrom hbase import search\n\nproject \u003d z.input(\"project\", \"FVE-2026-02\")\nstart \u003d date.fromisoformat(z.input(\"from\", \"2026-06-01\"))\nend \u003d date.fromisoformat(z.input(\"to\", \"2026-06-30\"))\nrows \u003d search.photos(project, start, end)\nprint(f\"{project}, {start} - {end}: {len(rows)} fotek (photos)\")\nz.show(pd.DataFrame(\n    [{\"taken_at\": (r[\"taken_at\"].strftime(\"%Y-%m-%d %H:%M:%S\") if r[\"taken_at\"] else None), \"lat\": r[\"lat\"], \"lon\": r[\"lon\"], \"size\": r[\"size_bytes\"], \"name\": r[\"original_name\"]}\n     for r in rows],\n    columns\u003d[\"taken_at\", \"lat\", \"lon\", \"size\", \"name\"],\n))\nthumbs \u003d \"\".join(\n    f\"\u003cimg src\u003d\u0027data:image/jpeg;base64,{base64.b64encode(r[\u0027thumb\u0027]).decode()}\u0027 title\u003d\u0027{r[\u0027original_name\u0027]}\u0027 \"\n    \"style\u003d\u0027margin:4px;border:1px solid #ccc\u0027\u003e\"\n    for r in rows[:6] if r[\"thumb\"]\n)\nprint(\"%html \u003cp\u003ePrvních 6 náhledů (first 6 thumbnails, stored in HBase):\u003c/p\u003e\" + thumbs)\n",
      "user": "anonymous",
      "dateUpdated": "2026-11-18 15:23:00.519",
      "progress": 0,
      "config": {},
