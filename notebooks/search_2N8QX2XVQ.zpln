    {
      "title": "Poslední výkres (Latest drawing of a project)",
      "text": "%python\n# Poslední výkres stavby: prefix \u003cprojekt\u003e#DRAWING# (the latest drawing of a project: one prefix scan)\nfrom hbase import search\n\nproject \u003d z.input(\"drawing_project\", \"FVE-2022-08\")\nfinal, warning \u003d search.latest_drawing(project)\nif final is None:\n    print(f\"%html \u003cp\u003e\u003cb\u003e{project}\u003c/b\u003e: žádný finální výkres (no final drawing)\u003c/p\u003e\")\nelse:\n    html \u003d (\n        f\"\u003cp\u003e\u003cb\u003e{project}\u003c/b\u003e: {final[\u0027original_name\u0027]} (verze {final[\u0027version\u0027]}, {final[\u0027file_date\u0027]})\u003cbr\u003e\"\n        f\"\u003ccode\u003e{final[\u0027raw_path\u0027]}\u003c/code\u003e\u003c/p\u003e\"\n    )\n    if warning:\n        html +\u003d f\"\u003cp style\u003d\u0027color:#b00020;font-weight:bold;font-size:1.1em\u0027\u003e{warning}\u003c/p\u003e\"\n    else:\n        html +\u003d \"\u003cp style\u003d\u0027color:#2e7d32\u0027\u003e✔ final je nejnovější verze (final is the newest version)\u003c/p\u003e\"\n    print(\"%html \" + html)\n",
      "user": "anonymous",
      "dateUpdated": "2026-11-18 15:22:34.307",
